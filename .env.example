# Copie para .env e ajuste. Nunca versione o arquivo .env.

# PostgreSQL (usado pelo serviço "db" do Docker Compose)
POSTGRES_DB=fiscaliza
POSTGRES_USER=fiscaliza
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://fiscaliza:troque-esta-senha@db:5432/fiscaliza
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
CAMARA_API_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
CEAP_ARQUIVO_URL_TEMPLATE=https://www.camara.leg.br/cotas/Ano-{ano}.csv.zip
HTTP_TIMEOUT_SEGUNDOS=30
HTTP_MAX_TENTATIVAS=5
DIRETORIO_DADOS_BRUTOS=/app/data/brutos

# Frontend
# URL usada pelo servidor Next.js (dentro da rede do Docker)
API_INTERNAL_URL=http://backend:8000
# URL pública exibida/usada no navegador
NEXT_PUBLIC_API_URL=http://localhost:8000

# Testes de integração (banco descartável, NUNCA o de produção)
TEST_DATABASE_URL=postgresql+psycopg://fiscaliza:troque-esta-senha@localhost:5432/fiscaliza_test
